<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ModManager.Plugins.LS25</RootNamespace>
    <AssemblyName>ModManager.Plugins.LS25</AssemblyName>
    <!-- Plugin-DLL braucht ihre transitiven Dependencies im Bundle
         (HtmlAgilityPack, Pfim, SkiaSharp inkl. native runtimes/).
         Ohne diese Property landen sie nicht in bin/. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets=runtime: kommt vom Host mit, nicht im Plugin-Bundle. -->
    <PackageReference Include="Kroste.ModManager.PluginContracts"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Diese sind plugin-spezifisch und müssen mit ins Bundle: -->
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Pfim" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
